# Copie para .env e preencha. O .env nao e versionado.
# Valores em: https://supabase.com/dashboard/project/<ref>/settings/api

SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Ignora RLS. Somente servidor. Nunca versionar nem expor ao browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_PROJECT_ID="<ref>"

# Espelho para o browser (Vite substitui em build time)
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<ref>"
